# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/bhoomi-setu?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/bhoomi-setu?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-sample.neonauth.c-2.us-east-2.aws.neon.build/bhoomi-setu/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-sample.neonauth.c-2.us-east-2.aws.neon.build/bhoomi-setu/auth
NEON_AUTH_COOKIE_SECRET=your-secret-cookie-encryption-key-min-32-chars

# S3 / Object Storage
AWS_ENDPOINT_URL_S3=https://storage.googleapis.com # or https://fly.storage.tigris.dev / https://s3.amazonaws.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Logging
LOG_LEVEL=debug
